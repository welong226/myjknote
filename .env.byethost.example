# Copy to .env.byethost (gitignored) and fill in from byethost VistaPanel → Account Settings / FTP
# Do NOT put real passwords in this example file — it is committed to Git.
FTP_SERVER=ftp.byethost.com
FTP_PORT=21
FTP_USERNAME=your_ftp_username
FTP_PASSWORD=your_ftp_password
# Remote web root. Common for byethost: /htdocs/
FTP_SERVER_DIR=/htdocs/
